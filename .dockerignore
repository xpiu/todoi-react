# Local state and build output never enter the image; the Dockerfile builds from source.
.git
# …except HEAD and the refs: vite.config.ts reads the commit being built from them (Settings › About, /api/health).
!.git/HEAD
!.git/refs/heads
!.git/packed-refs
**/node_modules
**/dist
**/dist-server
**/.tmp*
**/.state
storybook-static
coverage
.data
.dev
.DS_Store
.env
.env.*
!.env.example
*.log

# Not read by `npm run build`, so editing them doesn't rebuild the app
.github
.storybook
docs
tests
tools
*.md
