{
  "name": "todoi-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file=.env src/server/index.ts",
    "dev:web": "vite",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "build": "vite build && npm run build:server",
    "build:server": "vite build --ssr src/server/index.ts --outDir dist-server --emptyOutDir",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env node_modules/drizzle-kit/bin.cjs studio",
    "lint": "oxlint && stylelint \"src/client/**/*.css\"",
    "lint:js": "oxlint",
    "lint:css": "stylelint \"src/client/**/*.css\"",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test": "vitest run",
    "test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "claude-design-sync": "npm run design-sync -- serve",
    "design-sync": "tsx tools/claude-design-sync/src/cli.ts",
    "design-sync:check": "tsc --noEmit -p tools/claude-design-sync && vitest run --config tools/claude-design-sync/vitest.config.ts",
    "design-sync:e2e": "playwright test -c tools/claude-design-sync/playwright.config.ts",
    "design-sync:demo": "tsx tools/claude-design-sync/test/e2e-server.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hono/node-server": "^2.1.7",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "lucide-react": "^1.72.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.93.0",
    "storybook": "10.6.7",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
