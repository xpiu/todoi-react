# Copy to `.env` and adjust for your machine.
DATABASE_URL=postgres://localhost:5432/todoi_react
PORT=3000
# Development conveniences (default true outside production)
MIGRATE_ON_START=true
SEED_ON_START=true
# Auth (Better Auth). Set a long random secret outside development.
APP_URL=http://localhost:5173
BETTER_AUTH_SECRET=todoi-dev-secret-change-me-please
# Local uploads
UPLOAD_DIR=.data/uploads
