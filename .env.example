# Copy to `.env` and adjust for your machine.
DATABASE_URL=postgres://localhost:5432/todoi_react
PORT=3000
# Development conveniences (default true outside production)
MIGRATE_ON_START=true
SEED_ON_START=true
# Auth (Better Auth). Development values: production (NODE_ENV=production) refuses to start with them
# and needs the public https APP_URL and a fresh secret (openssl rand -base64 32). See README › Production.
APP_URL=http://localhost:5173
BETTER_AUTH_SECRET=todoi-dev-secret-change-me-please
# Local uploads (a persistent volume in production)
UPLOAD_DIR=.data/uploads
