# Copy to `.env` and adjust for your machine.
DATABASE_URL=postgres://localhost:5432/todoi_react
PORT=3000
# Development conveniences (default true outside production)
MIGRATE_ON_START=true
SEED_ON_START=true
# Auth (Better Auth). Development values: production (NODE_ENV=production) refuses to start with them
# and needs the public https APP_URL and a fresh secret (openssl rand -base64 32). See README › Production.
APP_URL=http://localhost:5173
BETTER_AUTH_SECRET=todoi-dev-secret-change-me-please
# Local uploads (a persistent volume in production)
UPLOAD_DIR=.data/uploads
# Email (password reset, email confirmation, invites) through Resend (resend.com). Without a key every
# email is written to EMAIL_DIR (.html, .txt, .json) and logged instead of sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Todoi <no-reply@todoi.com>
# EMAIL_DIR=.data/emails
# Request throttling (on in production): RATE_LIMIT=true here to try it locally. Behind a reverse proxy, set
# TRUST_PROXY_HOPS to the number of proxies that append to X-Forwarded-For (usually 1).
# RATE_LIMIT=false
# TRUST_PROXY_HOPS=0
# Git sync (a project kept in a file in a GitHub repository). Tokens are stored encrypted with SYNC_SECRET_KEY,
# or a key derived from BETTER_AUTH_SECRET when it is unset (rotating that secret then disconnects every repository).
# SYNC_SECRET_KEY=
# GITHUB_API_URL=https://api.github.com
# Who may open the operator console (/admin): comma-separated sign-in addresses, used once confirmed.
# Development defaults to the seeded info@todoi.org.
# ADMIN_EMAILS=info@todoi.com
