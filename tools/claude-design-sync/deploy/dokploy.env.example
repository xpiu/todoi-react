# Claude Design Sync on Dokploy: paste into the application's Environment tab (never commit real values).

# The repo the tool clones onto /data/repo, compares, merges into and pushes
CDS_GIT_URL=https://github.com/<owner>/todoi-react.git
CDS_GIT_BRANCH=main
# Fine-grained token with Contents read/write on that repo (clone, push after merge)
GITHUB_TOKEN=
GIT_AUTHOR_NAME=Claude Design Sync
GIT_AUTHOR_EMAIL=design-sync@todoi.com

# Same pair as Dokploy's Advanced > Security login, so the browser's one login satisfies both
CDS_BASIC_AUTH_USER=
CDS_BASIC_AUTH_PASS=

# Optional: Claude Code login without `claude /login` in the container terminal (from `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=

# Set by the image; override only if needed
# CDS_HOST=0.0.0.0
# CDS_PORT=4477
# CDS_PUSH_AFTER_MERGE=1
